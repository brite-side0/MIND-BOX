# MindBox MCP server
# Point this at your own MindBox deployment (defaults to a local server).
MINDBOX_URL=http://localhost:4021

# Select deployment network: testnet (default) or mainnet
STELLAR_NETWORK=testnet

# Optional overrides (defaults come from STELLAR_NETWORK preset)
# NETWORK=stellar:testnet
# SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
# HORIZON_URL=https://horizon-testnet.stellar.org
# USDC_CONTRACT_ID=CBIELTK6YBZJU5UP2WWQEUCYKLPU6AUNZ2BQ4WWFEIE3USCIHMXQDAMA
# Replace with the vault-registry contract ID from your own deployment (see contract/README.md).
VAULT_REGISTRY_CONTRACT_ID=C...

# Point this at your own sponsored-account service deployment.
SPONSORED_ACCOUNT_URL=https://your-mindbox-deployment.example.com

# ── Mainnet example ──────────────────────────────────────────────────────────
# STELLAR_NETWORK=mainnet
# NETWORK=stellar:pubnet
# SOROBAN_RPC_URL=https://soroban.stellar.org
# HORIZON_URL=https://horizon.stellar.org
# USDC_CONTRACT_ID=CCW67TSZV3SSS2HXMBQ5JFGCKJNXKZM7UQUWUZPUTHXSTZLEO7SJMI75
# VAULT_REGISTRY_CONTRACT_ID=C...   # Required on mainnet
